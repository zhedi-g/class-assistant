{
  "name": "class-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:mock": "vite --host --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test:m1": "node scripts/m1-test.mjs",
    "test:m2": "node scripts/m2-test.mjs",
    "test:m3": "node scripts/m3-test.mjs",
    "test:m4": "node scripts/m4-test.mjs",
    "test:m42": "node scripts/m42-test.mjs",
    "test:m5": "node scripts/m5-test.mjs",
    "test:m6": "node scripts/m6-test.mjs",
    "test:d1": "tsx scripts/d1-test.ts",
    "test:d2": "tsx scripts/d2-test.ts",
    "deploy": "vite build && node scripts/deploy.mjs",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
